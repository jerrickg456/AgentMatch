# ===========================================
# AgentMatch Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values

# -------------------------------------------
# AI Provider (Groq Free Tier + Fallbacks)
# -------------------------------------------
# Get free keys at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_primary_groq_key
GROQ_API_KEY_FALLBACK_1=gsk_your_secondary_groq_key
GROQ_API_KEY_FALLBACK_2=gsk_your_tertiary_groq_key

# Optional OpenAI Backup (if all Groq keys fail)
OPENAI_API_KEY=sk-your-openai-api-key

# -------------------------------------------
# Supabase (Database)
# -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -------------------------------------------
# n8n (Agent Engine)
# -------------------------------------------
N8N_WEBHOOK_BASE_URL=https://your-n8n-instance.railway.app
N8N_API_KEY=your-n8n-api-key

# -------------------------------------------
# LinkedIn Scraping (Bright Data / Proxycurl)
# -------------------------------------------
# Option A: Bright Data
BRIGHT_DATA_API_KEY=your-bright-data-key
# Option B: Proxycurl (simpler, recommended for MVP)
PROXYCURL_API_KEY=your-proxycurl-key

# -------------------------------------------
# Instagram Scraping (Apify)
# -------------------------------------------
APIFY_API_TOKEN=your-apify-token

# -------------------------------------------
# App Config
# -------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AgentMatch
